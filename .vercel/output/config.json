{
  "version": 3,
  "framework": {
    "name": "nitro",
    "version": "3.0.260610-beta"
  },
  "overrides": {},
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/assets/(.*)"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/mcp",
      "dest": "/api/mcp"
    },
    {
      "src": "/api/facebook-news",
      "dest": "/api/facebook-news"
    },
    {
      "src": "/api/content",
      "dest": "/api/content"
    },
    {
      "src": "/api/admin/versions",
      "dest": "/api/admin/versions"
    },
    {
      "src": "/api/admin/upload",
      "dest": "/api/admin/upload"
    },
    {
      "src": "/api/admin/session",
      "dest": "/api/admin/session"
    },
    {
      "src": "/api/admin/login",
      "dest": "/api/admin/login"
    },
    {
      "src": "/api/admin/content",
      "dest": "/api/admin/content"
    },
    {
      "src": "/(.*)",
      "dest": "/__server"
    }
  ]
}